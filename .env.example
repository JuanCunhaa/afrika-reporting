APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# F02 — credenciais Veracode: a conexão guarda só a referência env:NOME; o backend lê
# NOME_API_ID e NOME_API_KEY do ambiente. Configure SOMENTE com autorização (conta de API read-only).
# Nunca coloque valores reais neste arquivo nem no Git.
# AFRIKA_DEMO_VERACODE_API_ID=
# AFRIKA_DEMO_VERACODE_API_KEY=
# Limites opcionais da integração (padrões em backend/app/veracode/settings.py):
# AFRIKA_VERACODE_MODE=live
# AFRIKA_VERACODE_MAX_RETRIES=3
# AFRIKA_VERACODE_MAX_CONCURRENCY=4
# AFRIKA_VERACODE_CACHE_TTL=300

# F02.1 — VERACODE AMBIENTE DE TESTES (homologação opt-in). Copie para `.env` na RAIZ do repo e preencha
# localmente. O backend carrega `.env` automaticamente sem sobrescrever variáveis já definidas no sistema.
# Credenciais de TESTE, exclusivamente READ-ONLY e com papéis mínimos na Veracode. Nunca versionar.
AFRIKA_VC_TEST_API_ID=
AFRIKA_VC_TEST_API_KEY=
AFRIKA_VC_TEST_CONNECTION=env:AFRIKA_VC_TEST
# AFRIKA_VC_TEST_REGION=commercial
# Trava efetiva: qualquer valor diferente de true impede o backend de iniciar a integração.
VERACODE_READ_ONLY=true
# Testes reais só rodam com true + credenciais + `pytest backend/tests_live --run-veracode-live`.
VERACODE_LIVE_TESTS_ENABLED=false
